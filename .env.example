# =========================================================================
# LFCS School CMS - Environment Configuration Template
# =========================================================================

DATABASE_URL="postgresql://username:password@localhost:5432/lfcs_school_cms"
DIRECT_URL="postgresql://username:password@localhost:5432/lfcs_school_cms"

AUTH_SECRET="your-generated-auth-secret-here"
NEXTAUTH_URL="http://localhost:3001"

NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"

# Cloudinary Configuration
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="lfcs-school"

# SMTP Configuration for Enquiries, Admissions & Franchise Alerts
SMTP_HOST="smtppro.zoho.in"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Little Flower Group of Schools <info@lfgos.com>"
ADMIN_NOTIFICATION_EMAIL="info@lfgos.com"

# Shared Secret with the website for revalidation webhook & submissions
CMS_SHARED_SECRET="lfcs-school-secret-key-replace-in-production"

